{
  "dataset": "hayyanfaisal/fyp-cctv-a3-ch14-speed-estimation",
  "experiments": {
    "baseline": {
      "notebook": "hayyanfaisal/fyp-cctv-vehicle-tracking-baseline",
      "snapshot_version": 1,
      "output_pattern": "baseline/.*"
    },
    "geometry": {
      "notebook": "hayyanfaisal/fyp-cctv-automatic-vehicle-geometry",
      "snapshot_version": 2,
      "output_pattern": "geometry/.*"
    },
    "workflow": {
      "notebook": "hayyanfaisal/fyp-cctv-camera-calibration-workflow",
      "snapshot_version": 1,
      "output_pattern": "workflow_outputs/(runs|calibration_cache|inference_cache)/.*|workflow_verification.json"
    },
    "validation_inference": {
      "notebook": "hayyanfaisal/fyp-mercedes-speed-validation",
      "snapshot_version": 2,
      "output_pattern": "validation_inference/.*/(observations.json|geometry_run_report.json|tracks.json|reference.jpg)"
    },
    "validation_report": {
      "notebook": "hayyanfaisal/fyp-mercedes-calibration-validation-report",
      "snapshot_version": 1,
      "output_pattern": "mercedes_validation/.*"
    },
    "speed": {
      "notebook": "hayyanfaisal/fyp-cctv-experimental-speed-estimation",
      "snapshot_version": 3,
      "output_pattern": "speed_experiment/.*"
    },
    "calibration_comparison": {
      "notebook": "hayyanfaisal/fyp-per-video-calibration-method-comparison",
      "snapshot_version": 1,
      "output_pattern": "calibration_comparison_inference/.*"
    },
    "calibration_refinement_report": {
      "notebook": "hayyanfaisal/fyp-calibration-refinement-report",
      "snapshot_version": 3,
      "output_pattern": "calibration_comparison/.*"
    }
  }
}
